@model List<Libro>

@section Styles{
    <link href="~/css/books.css" rel="stylesheet" />
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        @if(ViewBag.Utente == "Admin")
        {
            <h1 class="mb-0">Libri</h1>
            <a class="btn btn-outline-dark" asp-controller="Libro" asp-action="Create">Aggiungi Libro</a>
        }
        else
        {
            <h1 class="mb-0">Libri Prenotati</h1>
            if (ViewBag.Prenota)
            {
                <a class="btn btn-outline-dark" asp-controller="Libro" asp-action="Reserve" asp-route-idCliente="@ViewBag.IdCliente">Prenota Libro</a>
            }
            else
            {
                <a class="btn btn-outline-dark disabled" aria-disabled="true" tabindex="-1" style="pointer-events: none; opacity: 0.5;">Prenota Libro</a>
            }
        }
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-secondary">Nessun libro disponibile.</div>
    }
    else
    {
        <table class="table table-striped table-bordered table-hover">
            <thead class="table-dark">
                <tr>
                    @{
                        if(ViewBag.Utente == "Admin")
                        {
                            <th>Id</th>
                            <th>Titolo</th>
                            <th>Autore</th>
                            <th>Anno</th>
                            <th>Paese</th>
                            <th>Lingua</th>
                            <th>Prezzo (€)</th>
                            <th>Pagine</th>
                            <th>Azioni</th>
                        }
                        else
                        {
                            <th>Id Prenotazione</th>
                            <th>Titolo Libro</th>
                            <th>Data Inizio Prestito</th>
                            <th>Data Fine Prestito</th>
                            <th>Stato</th>
                        }
                    }
                </tr>
            </thead>
            <tbody>                
                @{
                    if(ViewBag.Utente == "Admin")
                    {
                        foreach(var libro in Model)
                        {
                            <tr>
                                <td>@libro.IdLibro.ToString()</td>
                                <td>@libro.Titolo</td>
                                <td>@libro.Autore.Cognome @libro.Autore.Nome</td>
                                <td>@libro.Anno.ToString()</td>
                                <td>@libro.Paese.Nome</td>
                                <td>@libro.Lingua.Nome</td>
                                <td>@libro.Prezzo.ToString("F2")</td>
                                <td>@libro.Pagine.ToString()</td>
                                <td>
                                    <a class="mx-1 text-dark" asp-controller="Libro" asp-action="Edit" asp-route-id="@libro.IdLibro"><i class="bi bi-pencil-square"></i></a>
                                    <a class="mx-1 text-dark" id="btnDelete" data-bs-toggle="modal" data-bs-target="#deleteModal" data-id="@libro.IdLibro" style="cursor: pointer">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        foreach(var prenotazione in ViewBag.Prenotazioni)
                        {
                            <tr>
                                <td>@prenotazione.IdPrenotazione</td>

                                @foreach(var libro in Model)
                                {
                                    if(libro.IdLibro == prenotazione.IdLibro)
                                    {
                                        <td>@libro.Titolo</td>

                                        break;
                                    }
                                }

                                @foreach(var prestito in ViewBag.Prestiti)
                                {
                                    if(prestito.IdPrenotazione == prenotazione.IdPrenotazione)
                                    {
                                        <td>@prestito.DataInizio.ToString("dd/MM/yyyy")</td>
                                        <td>@prestito.DataFine.ToString("dd/MM/yyyy")</td>

                                        <td>

                                            @if (prestito.DataInizio.Date > DateTime.Now.Date)
                                            {
                                                <span class="stato prenotato">prenotato</span>
                                            }
                                            else
                                            {
                                                if (prestito.DataFine.Date >= DateTime.Now.Date)
                                                {
                                                    <span class="stato in-prestito">in prestito</span>
                                                }
                                                else
                                                {
                                                    <span class="stato fine-prestito">fine prestito</span>
                                                }
                                            }

                                        </td>

                                        break;
                                    }
                                }
                            </tr>
                        }
                    }
                }

                @{
                    if(ViewBag.Utente == "Cliente" && !ViewBag.Prenota)
                    {
                        <div class="alert alert-warning">Si è arrivati al limite di libri prenotati e in prestito contemporaneamente (max: 3 libri)</div>
                    }
                }

            </tbody>
        </table>
    }
</div>

<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Conferma eliminazione</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Sei sicuro di voler eliminare questo libro?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annulla</button>
                <form id="deleteForm" method="post">
                    <button type="submit" class="btn btn-danger">Elimina</button>
                </form>
            </div>
        </div>
    </div>
</div>

@{
    List<Libro> libri = new List<Libro>();

    if(ViewBag.Utente == "Cliente")
    {
        foreach(var prestito in ViewBag.Prestiti)
        {
            if (prestito.DataFine.Date == DateTime.Now.Date)
            {
                foreach (var prenotazione in ViewBag.Prenotazioni)
                {
                    if (prestito.IdPrenotazione == prenotazione.IdPrenotazione)
                    {
                        foreach (var libro in Model)
                        {
                            if (libro.IdLibro == prenotazione.IdLibro)
                            {
                                libri.Add(libro);
                                break;
                            }
                        }
                        break;
                    }
                }
            }
        }

        if(libri.Count > 0)
        {
            <div class="toast-container position-fixed bottom-0 end-0 p-3">
                <div id="liveToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true" data-bs-autohide="false">
                    <div class="toast-header">
                        <strong class="me-auto" style="color: #ffc10788">
                            AVVISO IMPORTANTE!
                            <i class="bi bi-exclamation-triangle"></i>
                        </strong>
                        <button type="button" class="btn-close m-0" data-bs-dismiss="toast" aria-label="Close"></button>
                    </div>
                    <div class="toast-body d-flex align-items-center justify-content-between" style="color: #ffc107BB">
                        <p class="m-0">Scarica per maggiori informazioni.</p>
                        <button type="button" class="btn btn-outline-warning btn-sm">Scarica</button>
                    </div>
                </div>
            </div>

            @section Scripts {
                <script src="~/js/Toast-Warning.js"></script>
                <script src="~/js/Delete-Book.js"></script>
            }
        }
    }
    else
    {
        @section Scripts {
            <script src="~/js/Delete-Book.js"></script>
        }
    }
}
